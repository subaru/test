{
  "name": "nihon-tidy",
  "version": "0.4.0",
  "description": "日本語データ（CSV・JSON・Excel・HTML・テキスト）の列の種類を推論し、正規化して、変更点をHTMLレポートで返すライブラリ",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./view": "./src/view/render.js",
    "./element": "./src/view/element.js"
  },
  "bin": {
    "nihon-tidy": "./bin/cli.js"
  },
  "files": [
    "src",
    "bin"
  ],
  "scripts": {
    "test": "node --test",
    "example": "node bin/cli.js examples/sample-sjis.csv --report examples/report.html --out examples/output.json"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "japanese",
    "data-cleaning",
    "normalize",
    "csv",
    "wareki",
    "report",
    "excel",
    "scraping",
    "html"
  ],
  "license": "MIT"
}
